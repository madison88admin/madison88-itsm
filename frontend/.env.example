# Frontend Configuration
REACT_APP_NAME=Madison88 ITSM
REACT_APP_VERSION=1.0.0
REACT_APP_ENV=development

# API Configuration (Create React App)
# Leave REACT_APP_API_URL empty in Netlify to use the same-origin /api proxy.
REACT_APP_API_URL=
REACT_APP_API_TIMEOUT=30000
REACT_APP_SOCKET_URL=
REACT_APP_AUTO_CLOSE_INTERVAL_MINUTES=60

# Feature Flags
REACT_APP_ENABLE_SOCKET_IO=true
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_ERROR_TRACKING=false

# UI Configuration
REACT_APP_ITEMS_PER_PAGE=50
REACT_APP_DEFAULT_TIMEZONE=UTC

# Support & Help
REACT_APP_SUPPORT_EMAIL=it-support@madison88.com
REACT_APP_KNOWLEDGE_BASE_URL=https://kb.madison88.com
